{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=YOUR_DB_NAME;Username=YOUR_DB_USER;Password=YOUR_DB_PASSWORD"
  },
  "Jwt": {
    "Key": "YOUR_JWT_SECRET_KEY_MINIMUM_32_CHARACTERS_LONG",
    "Issuer": "XenohAPI",
    "Audience": "XenohClient",
    "ExpiryMinutes": "60"
  },
  "Smtp": {
    "Host": "smtp.hostinger.com",
    "Port": 465,
    "Username": "YOUR_SMTP_USERNAME",
    "Password": "YOUR_SMTP_PASSWORD",
    "FromEmail": "YOUR_SMTP_FROM_EMAIL",
    "FromName": "Xenoh",
    "EnableSsl": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
