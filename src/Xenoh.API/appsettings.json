{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=YOUR_DB_NAME;Username=YOUR_DB_USER;Password=YOUR_DB_PASSWORD"
  },
  "Jwt": {
    "Key": "YOUR_JWT_SECRET_KEY_MINIMUM_32_CHARACTERS_LONG",
    "Issuer": "XenohAPI",
    "Audience": "XenohClient",
    "ExpiryMinutes": "60"
  },
  "Smtp": {
    "Host": "smtp.hostinger.com",
    "Port": 465,
    "Username": "YOUR_SMTP_USERNAME",
    "Password": "YOUR_SMTP_PASSWORD",
    "FromEmail": "YOUR_SMTP_FROM_EMAIL",
    "FromName": "Xenoh",
    "EnableSsl": true
  },
  "Authentication": {
    "FrontendUrl": "https://xenoh.online",
    "Google": {
      "ClientId": "YOUR_GOOGLE_CLIENT_ID",
      "ClientSecret": "YOUR_GOOGLE_CLIENT_SECRET"
    },
    "Facebook": {
      "AppId": "YOUR_FACEBOOK_APP_ID",
      "AppSecret": "YOUR_FACEBOOK_APP_SECRET"
    }
  },
  "SePay": {
    "ApiKey": "YOUR_SEPAY_API_KEY",
    "BankAccountNumber": "YOUR_BANK_ACCOUNT_NUMBER",
    "BankAccountName": "YOUR_BANK_ACCOUNT_NAME",
    "BankName": "YOUR_BANK_NAME",
    "ApiToken": "YOUR_API_TOKEN_SECURITY",
    "ApiBaseUrl": "https://my.sepay.vn/userapi",
    "HealthProbePath": "/transactions/count",
    "PreflightEnabled": true,
    "HealthTimeoutSeconds": 5
  },
  "OpenAi": {
    "ApiKey": "YOUR_OPENAI_API_KEY",
    "Model": "gpt-5.4-mini",
    "BaseUrl": "https://api.openai.com/v1",
    "TimeoutSeconds": 60
  },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 300
    },
    "Auth": {
      "PermitLimit": 10
    },
    "Ai": {
      "PermitLimit": 30
    },
    "Webhook": {
      "PermitLimit": 20
    }
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  },
  "Security": {
    "ExposeMetrics": false
  },
  "R2Avatar": {
    "AccountId": "YOUR_ACCOUNT_ID",
    "BucketName": "YOUR_BUCKET_NAME",
    "AccessKeyId": "YOUR_R2_AVATAR_ACCESS_KEY_ID",
    "SecretAccessKey": "YOUR_R2_AVATAR_SECRET_ACCESS_KEY",
    "PublicBaseUrl": "YOUR_USER_AVATAR_PUBLIC_BASE_URL"
  },
  "R2Share": {
    "AccountId": "YOUR_ACCOUNT_ID",
    "BucketName": "xenoh_bucket",
    "AccessKeyId": "YOUR_R2_SHARE_ACCESS_KEY_ID",
    "SecretAccessKey": "YOUR_R2_SHARE_SECRET_ACCESS_KEY",
    "PublicBaseUrl": "YOUR_SHARE_IMAGES_PUBLIC_BASE_URL"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "xenoh.online,www.xenoh.online,api.xenoh.app"
}
