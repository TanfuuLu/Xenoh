{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=xenoh_db;Username=postgres;Password=YOUR_LOCAL_DB_PASSWORD"
  },
  "Jwt": {
    "Key": "YOUR_LOCAL_JWT_SECRET_KEY_MINIMUM_32_CHARACTERS_LONG",
    "Issuer": "XenohAPI",
    "Audience": "XenohClient",
    "ExpiryMinutes": "60"
  },
  "Smtp": {
    "Host": "smtp.example.com",
    "Port": 465,
    "Username": "YOUR_SMTP_USERNAME",
    "Password": "YOUR_SMTP_PASSWORD",
    "FromEmail": "noreply@example.com",
    "FromName": "Xenoh",
    "EnableSsl": true
  },
  "Authentication": {
    "FrontendUrl": "http://localhost:5173",
    "Google": {
      "ClientId": "YOUR_GOOGLE_CLIENT_ID",
      "ClientSecret": "YOUR_GOOGLE_CLIENT_SECRET"
    },
    "Facebook": {
      "AppId": "YOUR_FACEBOOK_APP_ID",
      "AppSecret": "YOUR_FACEBOOK_APP_SECRET"
    }
  },
  "SePay": {
    "ApiKey": "YOUR_SEPAY_API_KEY",
    "BankAccountNumber": "YOUR_BANK_ACCOUNT_NUMBER",
    "BankAccountName": "YOUR_BANK_ACCOUNT_NAME",
    "BankName": "YOUR_BANK_NAME",
    "ApiToken": "YOUR_SEPAY_API_TOKEN",
    "ApiBaseUrl": "https://my.sepay.vn/userapi",
    "HealthProbePath": "/transactions/count",
    "PreflightEnabled": false,
    "HealthTimeoutSeconds": 5
  },
  "OpenAi": {
    "ApiKey": "YOUR_OPENAI_API_KEY",
    "Model": "gpt-5.4-mini",
    "BaseUrl": "https://api.openai.com/v1",
    "TimeoutSeconds": 60
  },
  "R2Avatar": {
    "AccountId": "44c2cd7271f5e959631a931efe0db48e",
    "BucketName": "user-avatar",
    "AccessKeyId": "YOUR_R2_AVATAR_ACCESS_KEY_ID",
    "SecretAccessKey": "YOUR_R2_AVATAR_SECRET_ACCESS_KEY",
    "PublicBaseUrl": "YOUR_USER_AVATAR_PUBLIC_BASE_URL"
  },
  "Cors": {
    "//": "Extra origins allowed to call the API with credentials (in addition to Authentication:FrontendUrl and dev localhost). Use exact scheme+host, no trailing slash. e.g. public domain served via Cloudflare tunnel.",
    "AllowedOrigins": [ "https://www.example.com" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  }
}
